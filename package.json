{
  "name": "agentpay-tests",
  "version": "0.1.0",
  "private": true,
  "description": "Integration and attack test suite for the AgentPay escrow program",
  "scripts": {
    "test": "ts-mocha -p ./tsconfig.json -t 1000000 tests/attacks.ts",
    "diagnostics": "ts-mocha -p ./tsconfig.json -t 1000000 tests/diagnostics.ts",
    "smoke": "ts-node --compiler-options '{\"module\":\"commonjs\",\"esModuleInterop\":true}' tests/gateway-smoke.ts",
    "settle-devnet": "ts-node --compiler-options '{\"module\":\"commonjs\",\"esModuleInterop\":true}' tests/settle-devnet.ts",
    "restart-test": "ts-node --compiler-options '{\"module\":\"commonjs\",\"esModuleInterop\":true}' tests/restart-durability.ts",
    "evidence-devnet": "ts-node --compiler-options '{\"module\":\"commonjs\",\"esModuleInterop\":true}' tests/evidence-devnet.ts"
  },
  "dependencies": {
    "@anchor-lang/core": "1.2.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0"
  },
  "devDependencies": {
    "@types/chai": "^4.3.11",
    "@types/mocha": "^10.0.6",
    "@types/node": "^22.10.0",
    "chai": "^4.4.1",
    "mocha": "^10.4.0",
    "ts-mocha": "^10.0.0",
    "tweetnacl": "^1.0.3",
    "typescript": "^5.6.0"
  }
}
