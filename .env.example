# Copy to .env and edit. `docker compose` reads .env automatically.
#   cp .env.example .env

# --- Solana ---------------------------------------------------------------
AGENTPAY_RPC_URL=https://api.devnet.solana.com

# The program NEW sessions are opened under. This is v2.
AGENTPAY_PROGRAM_ID=ApjxJKBUUd8EEAovQe74jS9qZsRCAC2bwe8hTx7TpS9m

# The older program, kept so sessions opened under it can still settle and
# refund. Settle-and-drain only: nothing new is opened here. Leave it set until
# every v1 session has drained; see docs/MIGRATION_V1_V2.md.
AGENTPAY_LEGACY_PROGRAM_ID=3aKGM6Cb4Rd5sPH5YmSFc9567xNCDDKschQ4u7y5xP2U

# Network label used in the 402 body. Derived from the RPC URL when unset, so
# the quote cannot claim devnet while talking to something else.
# AGENTPAY_NETWORK=solana:devnet

# --- Settlement keys ------------------------------------------------------
#
# TWO DIFFERENT KEYS, deliberately separate variables. Never point them at the
# same file: the whole custody property is that they are different keys with
# different powers.
#
# Both are CONTAINER paths, not host paths — the same string on Windows, macOS
# and Linux. The files live in ./secrets/ on the host and are never committed.
# Neither file is in the repository; see secrets/README.md to create them.

# AgentPay's OWN key. Settles v2 sessions. It can trigger a settlement and
# nothing else — it cannot change the amount (fixed by the agent's signature)
# or the destination (fixed by session.provider, which is in the PDA seeds).
# AGENTPAY_SETTLEMENT_AUTHORITY_KEYPAIR=/secrets/settlement-authority.json

# LEGACY. The PROVIDER's own key. Settles v1 sessions only, because the old
# program requires the provider's signature. Delete this once the last v1
# session drains — that is the point at which AgentPay holds no provider key.
# AGENTPAY_PROVIDER_KEYPAIR=/secrets/provider.json

# With neither set, the gateway runs verify-only: claims are still verified and
# limits still enforced, but settlement returns ERR_SETTLEMENT_UNAVAILABLE.
# With only the authority set, v2 sessions settle and v1 sessions report
# ERR_SETTLEMENT_UNAVAILABLE — which is correct, not a bug.

# --- Database -------------------------------------------------------------
# Under `docker compose` these three are enough: DATABASE_URL is assembled from
# them automatically. Change POSTGRES_PASSWORD for anything but local dev.
POSTGRES_USER=agentpay
POSTGRES_PASSWORD=agentpay
POSTGRES_DB=agentpay

# Running the gateway WITHOUT Docker? Set this instead — nothing assembles it
# for you. Unset, the gateway runs with no durable store.
# DATABASE_URL=postgres://agentpay:agentpay@localhost:5434/agentpay

# --- Paid resource path ---------------------------------------------------
# The API the gateway sells access to. Blank disables /v1/buy.
AGENTPAY_UPSTREAM_URL=http://provider:4021

# --- Ports (change if these clash on your machine) ------------------------
WEB_PORT=3100
PROVIDER_PORT=4021
GATEWAY_PORT=8080
POSTGRES_PORT=5434

# --- Rate limiting ---------------------------------------------------------
# Addresses whose X-Forwarded-For header may be believed.
#
# Empty (the default) means the header is ignored and every request is keyed on
# its TCP peer. That is safe — an unlisted caller can put anything in that
# header — but behind a reverse proxy the peer IS the proxy, so every public
# client shares one bucket and one noisy client rate-limits everybody.
#
# List the proxy here and the gateway keys on the address the proxy actually
# saw. Only list addresses you control.
# AGENTPAY_TRUSTED_PROXIES=127.0.0.1,::1

# --- Logging --------------------------------------------------------------
AGENTPAY_LOG=info,tower_http=warn

# --- DEVELOPMENT ONLY -----------------------------------------------------
# Disables on-chain reconciliation of /v1/session/open, so a caller can assert
# a deposit that was never escrowed. `npm run demo` needs it because its
# sessions are synthetic. NEVER set this in production.
# AGENTPAY_TRUST_OPEN_REQUESTS=1

# ---------------------------------------------------------------------------
# Control-plane admin token
#
# Guards /v1/agents, /v1/providers, /v1/approvals and /v1/agent/plan — every
# operation that changes who may spend, or decides a spend on a human's behalf.
# The money path is NOT behind it: claims are protected by signatures and
# on-chain reconciliation, and a shared secret there would break every agent.
#
# Leaving this unset is tolerated only while the gateway binds to 127.0.0.1.
# Binding anywhere else without a token is refused at startup, because the
# control plane would otherwise let anyone who can reach the port approve
# their own spends and suspend other people's agents.
#
# Generate one with:  openssl rand -hex 32
# AGENTPAY_ADMIN_TOKEN=

# ---------------------------------------------------------------------------
# Rate limits, per client IP, per minute
#
# The default for /v1/session/open is deliberately low: that endpoint performs
# a Solana RPC read on every request and needs no credential, so it is the one
# an attacker can use to burn a metered quota.
#
# The general limit is loose. The money path is gated by signatures and by a
# shape check that runs before any I/O, so a tight limit there would break
# legitimate high-volume agents without stopping an attacker.
#
# Behind a reverse proxy, the proxy must set the peer address — the limiter
# keys on the TCP peer and deliberately ignores X-Forwarded-For, which a
# caller can forge to get a fresh bucket per request.
# AGENTPAY_OPEN_RATE_LIMIT=20
# AGENTPAY_RATE_LIMIT=600

# ---------------------------------------------------------------------------
# Bind address
#
# Defaults to loopback. Binding anywhere else WITHOUT AGENTPAY_ADMIN_TOKEN is
# refused at startup, not at the first request.
# AGENTPAY_BIND_ADDR=127.0.0.1:8080

# ---------------------------------------------------------------------------
# Refuse any purchase by an agent that has no policy on record, instead of
# falling back to the permissive default. Recommended for a shared deployment.
# AGENTPAY_REQUIRE_AGENT_POLICY=1

# ---------------------------------------------------------------------------
# Console (web/) — where the Next.js app reaches the gateway.
# Under `docker compose` this is set for you to http://gateway:8080.
# AGENTPAY_GATEWAY_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# DANGER: permits a mainnet RPC URL. The program has never been audited and has
# never been deployed to mainnet. Do not set this.
# AGENTPAY_ALLOW_MAINNET=1
